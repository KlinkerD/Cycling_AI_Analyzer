# Vorlage – kopiere diese Datei als .env und fülle die Werte aus
# cp .env.example .env

# intervals.icu API-Zugangsdaten (wird nur vom intervals-service gebraucht)
# API-Key generieren: intervals.icu → Profil → Einstellungen → API
# Athlete-ID: steht in der URL: intervals.icu/athlete/i12345/calendar
INTERVALS_API_KEY=dein-api-key-hier
INTERVALS_ATHLETE_ID=i12345
# Wie oft der intervals-service nach neuen Aktivitaeten und Fitness-Werten schaut (Default 15m)
# INTERVALS_POLL_INTERVAL=15m

# Google Gemini API-Key (wird nur vom ai-service gebraucht)
# Key erstellen: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=dein-gemini-key-hier
# GEMINI_MODEL=gemini-2.5-flash

# Dein Leistungsprofil
CYCLING_FTP=250
CYCLING_MAX_HR=190

# Versand (delivery-service): Mail und Discord unabhaengig an/aus.
# REPORT_MAIL_TO und DISCORD_CHANNEL_ID sind jeweils das Ziel "default".
REPORT_MAIL_ENABLED=false
REPORT_MAIL_TO=du@example.com
REPORT_MAIL_FROM=
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_USERNAME=absender@example.com
SPRING_MAIL_PASSWORD=app-passwort

REPORT_DISCORD_ENABLED=false
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token). Geheim halten!
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=123456789012345678

# Weitere Discord-Ziele (logischer Name = Teil nach DESTINATIONS_), optional
# DELIVERY_DISCORD_DESTINATIONS_REPORTS=123456789012345678
# DELIVERY_DISCORD_DESTINATIONS_FITNESS=123456789012345678
# DELIVERY_DISCORD_DESTINATIONS_RECOMMENDATION=123456789012345678

# Wohin der report-service Reports schickt (KANAL:ziel, kommagetrennt).
# Leer = an "default" jedes aktiven Kanals.
# REPORT_TARGETS=DISCORD:reports,MAIL:default

# training-service: Zeitzone fuer "heute", Versandzeiten und Zeitplan
# (ersetzt FITNESS_SUMMARY_ZONE und RECOMMENDATION_ZONE).
# TRAINING_ZONE=Europe/Berlin

# Fitness-Zusammenfassung (training-service): einmal am Tag ab dieser Uhrzeit.
# FITNESS_SUMMARY_TIME=21:00
# Ziel beim delivery-service (Default DISCORD:fitness -> DELIVERY_DISCORD_DESTINATIONS_FITNESS oben setzen).
# Alles in den Standard-Kanal: FITNESS_TARGETS=DISCORD:default
# FITNESS_TARGETS=DISCORD:fitness

# Tagesempfehlung (training-service): alle 4 h neu fuer die Overview-Karte,
# einmal am Tag ab RECOMMENDATION_DAILY_TIME frisch berechnet nach Discord.
# Nach einem Neustart wird nur bis RECOMMENDATION_DAILY_CATCH_UP_UNTIL nachgeholt.
# RECOMMENDATION_DAILY_TIME=09:00
# RECOMMENDATION_DAILY_CATCH_UP_UNTIL=12:00
# RECOMMENDATION_REFRESH_CRON=0 0 */4 * * *
# Ziel beim delivery-service (Default DISCORD:recommendation -> DELIVERY_DISCORD_DESTINATIONS_RECOMMENDATION oben setzen).
# RECOMMENDATION_TARGETS=DISCORD:recommendation
