{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.26.0",
    "generators": {
      "report-api": {
        "generatorName": "typescript-angular",
        "inputSpec": "#{cwd}/openapi/report-api.yaml",
        "output": "#{cwd}/src/app/api/report",
        "additionalProperties": {
          "ngVersion": "17.3.0",
          "providedIn": "root",
          "serviceSuffix": "Api",
          "serviceFileSuffix": ".api",
          "enumPropertyNaming": "UPPERCASE",
          "supportsES6": true
        }
      },
      "fitness-api": {
        "generatorName": "typescript-angular",
        "inputSpec": "#{cwd}/openapi/fitness-api.yaml",
        "output": "#{cwd}/src/app/api/fitness",
        "additionalProperties": {
          "ngVersion": "17.3.0",
          "providedIn": "root",
          "serviceSuffix": "Api",
          "serviceFileSuffix": ".api",
          "enumPropertyNaming": "UPPERCASE",
          "supportsES6": true
        }
      },
      "recommendation-api": {
        "generatorName": "typescript-angular",
        "inputSpec": "#{cwd}/openapi/recommendation-api.yaml",
        "output": "#{cwd}/src/app/api/recommendation",
        "additionalProperties": {
          "ngVersion": "17.3.0",
          "providedIn": "root",
          "serviceSuffix": "Api",
          "serviceFileSuffix": ".api",
          "enumPropertyNaming": "UPPERCASE",
          "supportsES6": true
        }
      }
    }
  }
}
